# E-Pilketos v2.0 - Security Configuration for ProFreeHost / Apache
DirectoryIndex index.php index.html

# Blokir akses langsung ke file sensitif
<IfModule mod_authz_core.c>
    <FilesMatch "^(\.env|\.git|.*\.sql|.*\.sqlite)$">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "^(\.env|\.git|.*\.sql|.*\.sqlite)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# Blokir akses ke folder internal & pastikan trailing slash pada subfolder
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^config/ - [F,L]
    RewriteRule ^data/ - [F,L]
    
    # Pastikan akses /face-poc selalu diarahkan ke /face-poc/ (menghindari error 404 path assets)
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteCond %{REQUEST_URI} !/$
    RewriteRule ^(.*)$ $1/ [R=301,L]
</IfModule>

# Browser Caching untuk Model AI & Aset Statis
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType application/octet-stream "access plus 1 year"
    ExpiresByType application/json "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(bin|json|js|css|woff|woff2|png|jpg|jpeg|svg|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>


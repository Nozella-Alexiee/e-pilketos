# =============================================================================
# E-PILKETOS v2.0 - Environment Configuration
# Salin file ini menjadi .env jika menggunakan MySQL/MariaDB untuk deployment
# =============================================================================

# Pilihan Driver: mysql atau sqlite
DB_DRIVER=mysql

# Konfigurasi MySQL / MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=epilketos_sig
DB_USER=root
DB_PASS=

# (Opsional) Jika menggunakan SQLite lokal
# DB_DRIVER=sqlite
